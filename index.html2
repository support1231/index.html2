        <!-- Professional Plan (Highlighted) -->
        <div class="bg-gradient-to-b from-blue-950/40 via-slate-950 to-slate-950 p-8 rounded-2xl border-2 border-blue-500 flex flex-col justify-between shadow-2xl shadow-blue-500/10 relative">
